{
  "manifest_version": 3,
  "name": "C++ Crash Explainer for LeetCode",
  "version": "1.0.0",
  "description": "Translates cryptic AddressSanitizer and UBSan C++ errors on LeetCode into structured, actionable explanations.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cpp-crash-explainer@khushisharma.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": false
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
